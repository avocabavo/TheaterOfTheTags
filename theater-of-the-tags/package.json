{
  "name": "theater-of-the-tags",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:yjs\"",
    "dev:web": "vite",
    "dev:yjs": "PORT=1234 /usr/bin/y-websocket-server",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "masonry-layout": "^4.2.2",
    "vue": "^3.5.32",
    "y-websocket": "^3.0.0",
    "yaml": "^2.8.3",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vue-tsc": "^3.2.6"
  }
}
